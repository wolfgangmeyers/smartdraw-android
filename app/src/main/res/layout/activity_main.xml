<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:fitsSystemWindows="true">

    <!-- Top Toolbar -->
    <LinearLayout
        android:id="@+id/topToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1E1E1E"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- a) Active Tool (Pencil / Smudge) with Quick Settings Popup Trigger -->
        <ImageButton
            android:id="@+id/btnActiveTool"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_tool_button_active"
            android:src="@drawable/ic_pencil"
            android:tint="#FFFFFF"
            android:contentDescription="Active Tool &amp; Settings"
            android:scaleType="centerInside" />

        <!-- b) Auto Color Toggle -->
        <ImageButton
            android:id="@+id/btnAutoColor"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_tool_button_active"
            android:src="@drawable/ic_auto_color"
            android:tint="#FFFFFF"
            android:contentDescription="Auto Color Sampling"
            android:scaleType="centerInside" />

        <!-- c) Reset View (Fit / Target) -->
        <ImageButton
            android:id="@+id/btnResetView"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/btn_icon_selector"
            android:src="@drawable/ic_reset_view"
            android:tint="#B0B0B0"
            android:contentDescription="Reset Canvas View"
            android:scaleType="centerInside" />

        <!-- Flexible Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- d) Gallery Button -->
        <ImageButton
            android:id="@+id/btnGallery"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/btn_icon_selector"
            android:src="@drawable/ic_gallery"
            android:tint="#FFFFFF"
            android:contentDescription="Paintings Gallery"
            android:scaleType="centerInside" />

        <!-- e) Ellipsis (...) More Options & Load Image -->
        <ImageButton
            android:id="@+id/btnMoreOptions"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/btn_icon_selector"
            android:src="@drawable/ic_more"
            android:tint="#FFFFFF"
            android:contentDescription="More Options and Settings"
            android:scaleType="centerInside" />

    </LinearLayout>

    <!-- Dedicated Status Banner -->
    <LinearLayout
        android:id="@+id/statusBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#181818"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ready - Draw with stylus, pan/zoom with two fingers"
            android:textColor="#E0E0E0"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- OpenGL Canvas Surface -->
    <FrameLayout
        android:id="@+id/canvasContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.smartdraw.SmartDrawView
            android:id="@+id/smartDrawView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

</LinearLayout>
