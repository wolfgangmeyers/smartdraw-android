<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E1E1E"
    android:padding="20dp">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Import Source Image"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/textOriginalDimensions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Original: 1200 × 1600 (1.9 MP)"
        android:textColor="#B0B0B0"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Canvas Resolution Scale:"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textScaleMultiplier"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="1x"
            android:textColor="#2979FF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/sliderScale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="7"
        android:progress="0"
        android:progressTint="#2979FF"
        android:thumbTint="#2979FF"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/textResultDimensions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Canvas Resolution: 1200 × 1600 (1.9 MP)"
        android:textColor="#00E676"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/textGpuLimitWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Note: Maximum texture dimension is 8192 px"
        android:textColor="#FFAB00"
        android:textSize="12sp"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnCancelImport"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="#B0B0B0"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnConfirmImport"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Import &amp; Create Canvas"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2979FF" />
    </LinearLayout>

</LinearLayout>
