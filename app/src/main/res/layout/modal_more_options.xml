<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <!-- Drag handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sheet_drag_handle"
            android:layout_marginBottom="16dp" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings &amp; Actions"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="18dp" />

        <!-- SECTION 0: Paintings & Gallery -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAINTINGS"
            android:textColor="#2979FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenGalleryModal"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Gallery"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:icon="@drawable/ic_gallery"
                app:iconTint="#FFFFFF"
                app:iconGravity="textStart"
                app:backgroundTint="#2D2D2D"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNewPaintingModal"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="New Painting"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:icon="@drawable/ic_add"
                app:iconTint="#FFFFFF"
                app:iconGravity="textStart"
                app:backgroundTint="#2979FF"
                app:cornerRadius="10dp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="18dp" />

        <!-- SECTION 1: Source Image -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SOURCE IMAGE"
            android:textColor="#2979FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="12dp" />

        <!-- Change Source Image button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangeSourceImage"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Select / Change Source Image"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:icon="@drawable/ic_image"
            app:iconTint="#FFFFFF"
            app:iconGravity="textStart"
            app:backgroundTint="#2D2D2D"
            app:cornerRadius="10dp"
            android:layout_marginBottom="12dp" />

        <!-- Opacity Header with Percentage Text -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Source Image Opacity"
                android:textColor="#E0E0E0"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textOpacityValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30%"
                android:textColor="#2979FF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Opacity Slider -->
        <SeekBar
            android:id="@+id/sliderOpacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="30"
            android:thumbTint="#2979FF"
            android:progressTint="#2979FF"
            android:progressBackgroundTint="#424242"
            android:layout_marginBottom="10dp" />

        <!-- Toggle Visibility Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleSourceVisibility"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Hide Source Image"
            android:textColor="#B0B0B0"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:strokeColor="#424242"
            app:icon="@drawable/ic_visibility_off"
            app:iconTint="#B0B0B0"
            app:iconGravity="textStart"
            app:cornerRadius="10dp"
            android:layout_marginBottom="16dp" />

        <!-- Ratchet Mode Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ratchet Mode"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textRatchetHelper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Keep strokes only if similarity to source improves"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchRatchetMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="18dp" />

        <!-- SECTION 2: Canvas Actions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CANVAS ACTIONS"
            android:textColor="#2979FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <!-- Clear Painting -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearPainting"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Clear Canvas"
                android:textColor="#FF5252"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:icon="@drawable/ic_delete"
                app:iconTint="#FF5252"
                app:iconGravity="textStart"
                app:backgroundTint="#2D2D2D"
                app:cornerRadius="10dp" />

            <!-- Reset View -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetCanvasView"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Reset View"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:icon="@drawable/ic_reset_view"
                app:iconTint="#FFFFFF"
                app:iconGravity="textStart"
                app:backgroundTint="#2D2D2D"
                app:cornerRadius="10dp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="18dp" />

        <!-- SECTION 3: Dev & Testing -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEV / TESTING"
            android:textColor="#2979FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRunHarnessModal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Run Test Harness"
            android:textColor="#00E676"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:icon="@drawable/ic_play"
            app:iconTint="#00E676"
            app:iconGravity="textStart"
            app:backgroundTint="#243324"
            app:strokeColor="#00E676"
            app:strokeWidth="1dp"
            app:cornerRadius="10dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
