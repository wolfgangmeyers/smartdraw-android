<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <!-- Drag handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sheet_drag_handle"
            android:layout_marginBottom="16dp" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tool &amp; Brush Settings"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="18dp" />

        <!-- SECTION 1: Active Tool Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TOOL SELECTION"
            android:textColor="#2979FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <!-- Paintbrush Card Button -->
            <LinearLayout
                android:id="@+id/cardToolBrush"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/bg_tool_card_active"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconBrush"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_brush"
                    android:tint="#2979FF"
                    android:contentDescription="Paintbrush" />

                <TextView
                    android:id="@+id/textBrush"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Brush"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Pen Card Button -->
            <LinearLayout
                android:id="@+id/cardToolPen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/bg_tool_card_inactive"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconPen"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_pen"
                    android:tint="#B0B0B0"
                    android:contentDescription="Pen" />

                <TextView
                    android:id="@+id/textPen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Pen"
                    android:textColor="#B0B0B0"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Smudge Card Button -->
            <LinearLayout
                android:id="@+id/cardToolSmudge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/bg_tool_card_inactive"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconSmudge"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_smudge"
                    android:tint="#B0B0B0"
                    android:contentDescription="Smudge" />

                <TextView
                    android:id="@+id/textSmudge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Smudge"
                    android:textColor="#B0B0B0"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="18dp" />

        <!-- SECTION 2: Brush Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/textSettingsSectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BRUSH SETTINGS"
                android:textColor="#2979FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- Live Brush Preview Dot -->
            <com.smartdraw.ui.BrushPreviewView
                android:id="@+id/brushPreview"
                android:layout_width="48dp"
                android:layout_height="48dp" />

        </LinearLayout>

        <!-- Brush Size Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Brush Size"
                android:textColor="#E0E0E0"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textSizeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="16 px"
                android:textColor="#2979FF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Brush Size Slider: 0.5 to 100 px -->
        <SeekBar
            android:id="@+id/sliderBrushSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="199"
            android:progress="31"
            android:thumbTint="#2979FF"
            android:progressTint="#2979FF"
            android:progressBackgroundTint="#424242"
            android:layout_marginBottom="16dp" />

        <!-- Brush Opacity Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stroke Opacity"
                android:textColor="#E0E0E0"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textBrushOpacityValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textColor="#2979FF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Brush Opacity Slider: 1% to 100% -->
        <SeekBar
            android:id="@+id/sliderBrushOpacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="99"
            android:progress="99"
            android:thumbTint="#2979FF"
            android:progressTint="#2979FF"
            android:progressBackgroundTint="#424242"
            android:layout_marginBottom="8dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
