<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <!-- Drag handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sheet_drag_handle"
            android:layout_marginBottom="16dp" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tool &amp; Brush Settings"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="18dp" />

        <!-- SECTION 1: Active Tool Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TOOL SELECTION"
            android:textColor="#2979FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <!-- Pencil Card Button -->
            <LinearLayout
                android:id="@+id/cardToolPencil"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/bg_tool_card_active"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconPencil"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_pencil"
                    android:tint="#2979FF"
                    android:contentDescription="Pencil" />

                <TextView
                    android:id="@+id/textPencil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Pencil"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Smudge Card Button -->
            <LinearLayout
                android:id="@+id/cardToolSmudge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/bg_tool_card_inactive"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iconSmudge"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_smudge"
                    android:tint="#B0B0B0"
                    android:contentDescription="Smudge" />

                <TextView
                    android:id="@+id/textSmudge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Smudge"
                    android:textColor="#B0B0B0"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="18dp" />

        <!-- SECTION 2: Brush Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/textSettingsSectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BRUSH SETTINGS"
                android:textColor="#2979FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- Live Brush Preview Dot -->
            <com.smartdraw.ui.BrushPreviewView
                android:id="@+id/brushPreview"
                android:layout_width="48dp"
                android:layout_height="48dp" />

        </LinearLayout>

        <!-- Brush Size Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Brush Size"
                android:textColor="#E0E0E0"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textSizeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="16 px"
                android:textColor="#2979FF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Brush Size Slider: 2 to 100 px -->
        <SeekBar
            android:id="@+id/sliderBrushSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="98"
            android:progress="14"
            android:thumbTint="#2979FF"
            android:progressTint="#2979FF"
            android:progressBackgroundTint="#424242"
            android:layout_marginBottom="16dp" />

        <!-- Brush Opacity Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stroke Opacity"
                android:textColor="#E0E0E0"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textBrushOpacityValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textColor="#2979FF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Brush Opacity Slider: 1% to 100% -->
        <SeekBar
            android:id="@+id/sliderBrushOpacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="99"
            android:progress="99"
            android:thumbTint="#2979FF"
            android:progressTint="#2979FF"
            android:progressBackgroundTint="#424242"
            android:layout_marginBottom="8dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="18dp" />

        <!-- SECTION 3: Color Selection -->
        <TextView
            android:id="@+id/textColorSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="COLOR SELECTION"
            android:textColor="#2979FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="12dp" />

        <!-- Auto Color Notice Container (visible when Auto Color is ON) -->
        <LinearLayout
            android:id="@+id/layoutAutoColorNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_tool_card_inactive"
            android:padding="14dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto Color is currently enabled. The brush automatically samples colors from your reference image."
                android:textColor="#E0E0E0"
                android:textSize="13sp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:id="@+id/btnDisableAutoColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tool_button_active"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Switch to Manual Color"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Manual Color Container (visible when Auto Color is OFF) -->
        <LinearLayout
            android:id="@+id/layoutManualColorControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Swatch, Hex, and Eyedropper Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <!-- Color Swatch Preview Dot -->
                <View
                    android:id="@+id/colorSwatchPreview"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="12dp" />

                <!-- Hex Display -->
                <TextView
                    android:id="@+id/textColorHex"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#000000"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Eyedropper Button -->
                <LinearLayout
                    android:id="@+id/btnEyedropper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tool_button_inactive"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iconEyedropper"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_eyedropper"
                        android:tint="#2979FF"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="Eyedropper" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Eyedropper"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- Mode Switcher: RGB vs HSL Toggle Button Group -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/btnModeRgb"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="RGB"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="@drawable/bg_tool_button_active"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnModeHsl"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="HSL"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="@drawable/bg_tool_button_inactive"
                    android:textColor="#B0B0B0"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- RGB Sliders Container -->
            <LinearLayout
                android:id="@+id/layoutRgbSliders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Red -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Red"
                        android:textColor="#E0E0E0"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/textRedValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FF5252"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <SeekBar
                    android:id="@+id/sliderRed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="255"
                    android:progress="0"
                    android:thumbTint="#FF5252"
                    android:progressTint="#FF5252"
                    android:progressBackgroundTint="#424242"
                    android:layout_marginBottom="12dp" />

                <!-- Green -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Green"
                        android:textColor="#E0E0E0"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/textGreenValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#4CAF50"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <SeekBar
                    android:id="@+id/sliderGreen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="255"
                    android:progress="0"
                    android:thumbTint="#4CAF50"
                    android:progressTint="#4CAF50"
                    android:progressBackgroundTint="#424242"
                    android:layout_marginBottom="12dp" />

                <!-- Blue -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Blue"
                        android:textColor="#E0E0E0"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/textBlueValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#2979FF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <SeekBar
                    android:id="@+id/sliderBlue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="255"
                    android:progress="0"
                    android:thumbTint="#2979FF"
                    android:progressTint="#2979FF"
                    android:progressBackgroundTint="#424242"
                    android:layout_marginBottom="8dp" />

            </LinearLayout>

            <!-- HSL Sliders Container -->
            <LinearLayout
                android:id="@+id/layoutHslSliders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Hue -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Hue"
                        android:textColor="#E0E0E0"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/textHueValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0°"
                        android:textColor="#FF9800"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <SeekBar
                    android:id="@+id/sliderHue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="360"
                    android:progress="0"
                    android:thumbTint="#FF9800"
                    android:progressTint="#FF9800"
                    android:progressBackgroundTint="#424242"
                    android:layout_marginBottom="12dp" />

                <!-- Saturation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Saturation"
                        android:textColor="#E0E0E0"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/textSaturationValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#E91E63"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <SeekBar
                    android:id="@+id/sliderSaturation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="0"
                    android:thumbTint="#E91E63"
                    android:progressTint="#E91E63"
                    android:progressBackgroundTint="#424242"
                    android:layout_marginBottom="12dp" />

                <!-- Lightness -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Lightness"
                        android:textColor="#E0E0E0"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/textLightnessValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="#9C27B0"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <SeekBar
                    android:id="@+id/sliderLightness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="0"
                    android:thumbTint="#9C27B0"
                    android:progressTint="#9C27B0"
                    android:progressBackgroundTint="#424242"
                    android:layout_marginBottom="8dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
